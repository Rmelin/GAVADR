APP_ENV=production
DATABASE_URL=postgresql+asyncpg://gavadr:change-me@db:5432/gavadr
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760
ADDRESS_IMPORT_MAX_BYTES=2097152
ADDRESS_IMPORT_MAX_ROWS=5000
ORGANIZATION_NAME=GAVAD
ORGANIZATION_ADDRESS=
ORGANIZATION_LOCALITY=
MAP_DEFAULT_LONGITUDE=11.45
MAP_DEFAULT_LATITUDE=55.62
MAP_DEFAULT_ZOOM=13
PUBLIC_STATUS_DIR=/data/public-status
PUBLIC_STATUS_FILENAME=driftsstatus.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
BOARD_NOTIFICATION_EMAILS=[]
FRONTEND_URL=https://app.example.dk
ALLOWED_ORIGINS=["https://app.example.dk"]
FORWARDED_ALLOW_IPS=127.0.0.1
